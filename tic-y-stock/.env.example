# Configuración de TIC & Stock
# Copiá este archivo como `.env` y ajustá los valores si hace falta:
#     copy .env.example .env      (Windows PowerShell)
#
# `.env` está en .gitignore: no lo subas al repositorio.
# Todos los valores son opcionales: si no creás el archivo, la app usa estos
# mismos defaults.

# ---------------------------------------------------------------- Puerto
# Puerto del servidor. Para que otras notebooks de la red escolar accedan,
# el servidor ya escucha en 0.0.0.0 (no cambiar a 127.0.0.1).
PORT=3000

# ---------------------------------------------------------------- MySQL
# Defaults pensados para XAMPP (MySQL en 127.0.0.1:3306, root sin contraseña).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tic_stock

# ---------------------------------------------------------------- Sesiones
# Secreto con el que se firman las cookies de sesión.
# IMPORTANTE: en la implementación real cambiá este valor por una cadena larga
# y aleatoria. Si lo dejás como está, cualquiera que conozca el código puede
# firmar sesiones ajenas.
SESSION_SECRET=cambiar-esto-por-una-cadena-larga-y-aleatoria

# ---------------------------------------------------------------- Alertas (F7)
# Días que puede estar un material afuera antes de que la devolución figure
# como vencida en el panel del superusuario. Si no se define, son 7.
PLAZO_PRESTAMO_DIAS=7

# ---------------------------------------------------------------- Seed
# Cuenta de superusuario que crea `npm run db:seed`.
# No hay registro público de superusuarios: esta es la única vía de alta
# para docentes / jefe de taller.
SEED_NOMBRE=Docente TIC
SEED_EMAIL=docente@ticystock.ar
SEED_CONTRASENA=docente123