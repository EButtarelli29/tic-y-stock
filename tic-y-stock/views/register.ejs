<%- include('partials/head') %>
  <div class="auth-center">
    <div class="auth-logo">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </svg>
      <span>TIC &amp; Stock</span>
    </div>

    <section class="card">
      <div class="card-header">
        <h2>Crear cuenta</h2>
        <p>Completá tus datos para comenzar a gestionar el inventario del taller</p>
      </div>

      <% if (Object.keys(errores).length > 0) { %>
        <div class="alert" role="alert">Revisá los campos marcados en el formulario.</div>
      <% } %>

      <form action="/register" method="post" novalidate id="register-form">
        <div class="field">
          <label for="nombre">Nombre completo</label>
          <input id="nombre" name="nombre" type="text" placeholder="Juan Pérez"
                 value="<%= datos.nombre %>" required autocomplete="name" />
          <small class="field-error" data-error-for="nombre"><%= errores.nombre || '' %></small>
        </div>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" placeholder="tu@ejemplo.com"
                 value="<%= datos.email %>" required autocomplete="email" />
          <small class="field-error" data-error-for="email"><%= errores.email || '' %></small>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" placeholder="Mín. 6 caracteres"
                   required autocomplete="new-password" />
            <small class="field-error" data-error-for="password"><%= errores.contraseña || '' %></small>
          </div>
          <div class="field">
            <label for="confirmar">Confirmar</label>
            <input id="confirmar" name="confirmar_contrasena" type="password" placeholder="Repetí la contraseña"
                   required autocomplete="new-password" />
            <small class="field-error" data-error-for="confirmar_contrasena"><%= errores.confirmar_contrasena || '' %></small>
          </div>
        </div>

        <button type="submit" class="btn btn--primary btn--block" id="register-submit">Crear cuenta</button>
        <p class="auth-switch">¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>
      </form>
    </section>
  </div>
  <script src="/js/register.js" defer></script>
</body>
</html>