<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="page">
  <header class="page-header">
    <div>
      <h1>Panel del superusuario</h1>
      <p>Resumen del estado actual del pañol.</p>
    </div>
    <div class="page-header-actions">
      <a class="btn btn--primary" href="/admin/inventario/nuevo">Nuevo ítem</a>
      <a class="btn btn--outline" href="/admin/inventario">Ver inventario</a>
    </div>
  </header>

  <section class="stat-grid">
    <div class="stat-card">
      <span class="stat-label">Ítems en inventario</span>
      <strong class="stat-value"><%= resumen.totalItems %></strong>
      <a class="stat-link" href="/admin/inventario">Ver listado</a>
    </div>
    <div class="stat-card">
      <span class="stat-label">Préstamos activos</span>
      <strong class="stat-value"><%= resumen.prestamosActivos %></strong>
      <a class="stat-link" href="/admin/movimientos?abiertos=1">Ver quién tiene material</a>
    </div>
    <div class="stat-card">
      <span class="stat-label">Stock crítico</span>
      <strong class="stat-value <%= resumen.stockCritico > 0 ? 'text-critical' : '' %>"><%= resumen.stockCritico %></strong>
      <a class="stat-link" href="/admin/inventario?stock_critico=1">Revisar inventario</a>
    </div>
    <div class="stat-card">
      <span class="stat-label">Alertas activas</span>
      <strong class="stat-value <%= resumen.alertasActivas > 0 ? 'text-critical' : '' %>"><%= resumen.alertasActivas %></strong>
      <a class="stat-link" href="/admin/alertas"><%= resumen.alertasVencidas %> vencida(s)</a>
    </div>
    <div class="stat-card">
      <span class="stat-label">Cuentas de superusuario</span>
      <strong class="stat-value"><%= resumen.totalSuperusuarios %></strong>
      <a class="stat-link" href="/admin/usuarios">Gestionar usuarios</a>
    </div>
  </section>

  <% if (resumen.alertasActivas > 0) { %>
  <section class="card panel-block">
    <div class="card-header panel-block-header">
      <h2>Devoluciones pendientes</h2>
      <a class="btn btn--outline btn--sm" href="/admin/alertas">Ver todas</a>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Ítem</th>
            <th>Cant.</th>
            <th>Usuario</th>
            <th>Retirado</th>
            <th>Vence</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% resumen.alertas.forEach((a) => { %>
            <tr>
              <td><%= a.item_nombre %></td>
              <td><%= a.cantidad %></td>
              <td><%= a.usuario_nombre %></td>
              <td><%= new Date(a.fecha_hora).toLocaleDateString('es-AR') %></td>
              <td><%= a.fecha_vencimiento_txt %></td>
              <td>
                <% if (a.dias_para_vencer < 0) { %>
                  <span class="badge badge--vencida">Vencida hace <%= -a.dias_para_vencer %> d</span>
                <% } else { %>
                  <span class="badge badge--activo">Pendiente</span>
                <% } %>
              </td>
              <td><a class="btn btn--outline btn--sm" href="/admin/movimientos/devolucion?retiro=<%= a.id_movimiento %>">Devolver</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <% } %>

  <section class="card panel-block">
    <div class="card-header panel-block-header">
      <h2>Últimos movimientos</h2>
      <a class="btn btn--outline btn--sm" href="/admin/movimientos">Ver historial completo</a>
    </div>

    <% if (resumen.ultimosMovimientos.length === 0) { %>
      <div class="empty-state">
        <p>Todavía no hay movimientos registrados. Cuando se carguen retiros y devoluciones, vas a ver el historial acá.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Movimiento</th>
              <th>Ítem</th>
              <th>Cant.</th>
              <th>Usuario</th>
              <th>Fecha y hora</th>
            </tr>
          </thead>
          <tbody>
            <% resumen.ultimosMovimientos.forEach((m) => { %>
              <tr>
                <td><span class="badge badge--mov badge--<%= m.tipo %>"><%= m.tipo === 'retiro' ? 'Retiro' : 'Devolución' %></span></td>
                <td><%= m.item_nombre %></td>
                <td><%= m.cantidad %></td>
                <td><%= m.usuario_nombre %></td>
                <td><%= new Date(m.fecha_hora).toLocaleString('es-AR') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>
</body>
</html>